    "tech_stock_regulatory": {
      "name": "Tech Stock Regulatory Announcements",
      "description": "HKEX regulatory announcements for tech stocks (excluding semiconductor stocks)",
      "crawler": {
        "type": "regulatory",
        "function": "crawl_regulatory_announcements",
        "module": "crawlers.regulatory_announcement_crawler",
        "inputs": {
          "stock_codes": {
            "source": "inherit",
            "inherit_from": "regulatory",
            "description": "Uses same stock codes as regulatory component (all stocks are crawled)"
          },
          "dates": {
            "source": "auto",
            "default": "today_and_previous_trading_day",
            "description": "Automatically calculates today and previous trading day"
          }
        },
        "output": {
          "type": "csv",
          "file": "regulatory.csv",
          "description": "Shares the same CSV file as regulatory component"
        }
      },
      "summarizer": {
        "type": "csv_based_filtered",
        "function": "summarize_tech_stock_regulatory_announcements",
        "module": "summarizers.tech_stock_regulatory_summarizer",
        "inputs": {
          "data_source": {
            "type": "csv",
            "file": "regulatory.csv",
            "required": true
          },
          "stock_codes": {
            "source": "inline",
            "default": [
              "09988",
              "00700",
              "09888",
              "09618",
              "09999",
              "01024",
              "03690",
              "01810",
              "01211",
              "09866",
              "09868",
              "02015",
              "09863",
              "00020",
              "09660",
              "02525",
              "02665",
              "02498",
              "02590",
              "02432",
              "09880",
              "02026",
              "00800",
              "01021",
              "00100",
              "02513"
            ],
            "required": false,
            "customizable": true,
            "description": "List of 5-digit stock codes to include in summary (excludes semiconductor stocks: 01347, 00981, 06082). Alternative: use company_names instead."
          },
          "company_names": {
            "source": "inline",
            "default": null,
            "required": false,
            "customizable": true,
            "description": "Optional: List of company names to include in summary. If provided, filters by company name instead of stock codes. Example: [\"Alibaba\", \"Tencent\", \"Baidu\"]"
          },
          "date_filter": {
            "default": "today_and_previous_trading_day"
          },
          "section_title": {
            "default": "Tech Stock Regulatory Announcements",
            "customizable": true
          }
