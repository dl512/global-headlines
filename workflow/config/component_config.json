{
  "components": {
    "top_news": {
      "name": "Top News",
      "description": "Major global news stories from BBC, CNN, CNBC",
      "crawler": {
        "type": "generic_news",
        "config_key": "top_news",
        "function": "crawl_top_news",
        "module": "crawlers.generic_news_crawler",
        "inputs": {
          "websites": {
            "value": [
              "https://www.bbc.com/news",
              "https://edition.cnn.com/world",
              "https://www.cnbc.com/politics/"
            ],
            "required": true,
            "customizable": true,
            "description": "List of news websites to crawl"
          },
          "date_filter_mode": {
            "value": "none",
            "default": "none",
            "options": [
              "none",
              "today",
              "today_or_yesterday"
            ]
          },
          "special_handling": {
            "value": {},
            "default": {}
          }
        },
        "output": {
          "type": "csv",
          "file": "top_news.csv",
          "columns": [
            "Date",
            "Headline",
            "Link",
            "Summary"
          ]
        }
      },
      "summarizer": {
        "type": "csv_based",
        "function": "summarize_top_news",
        "module": "summarizers.top_news_summarizer",
        "inputs": {
          "data_source": {
            "type": "csv",
            "file": "top_news.csv",
            "required": true
          },
          "section_title": {
            "default": "Most Important Stories",
            "customizable": true
          },
          "date_filter": {
            "default": "today",
            "options": [
              "today",
              "all"
            ]
          }
        },
        "output": {
          "format": "markdown",
          "section_title": "Most Important Stories"
        }
      },
      "customization": {
        "websites": {
          "can_customize": true,
          "method": "replace",
          "description": "Replace default websites with custom list"
        },
        "section_title": {
          "can_customize": true,
          "method": "replace",
          "description": "Custom section title in newsletter"
        }
      }
    },
    "hk_news": {
      "name": "Hong Kong News",
      "description": "Most important Hong Kong news related to politics, social, and economy from Now News, Sing Tao, Ming Pao",
      "crawler": {
        "type": "generic_news",
        "config_key": "hk_news",
        "function": "crawl_hk_news",
        "module": "crawlers.generic_news_crawler",
        "inputs": {
          "websites": {
            "value": [
              "https://news.now.com/home/local",
              "https://www.stheadline.com/news/%E6%B8%AF%E8%81%9E",
              "https://news.mingpao.com/%E6%98%8E%E5%A0%B1%E6%96%B0%E8%81%9E%E7%B6%B2/main"
            ],
            "required": true,
            "customizable": true,
            "description": "List of Hong Kong news websites to crawl"
          },
          "date_filter_mode": {
            "value": "today",
            "default": "today",
            "options": [
              "none",
              "today",
              "today_or_yesterday"
            ]
          },
          "special_handling": {
            "value": {},
            "default": {}
          }
        },
        "output": {
          "type": "csv",
          "file": "hk_news.csv",
          "columns": [
            "Date",
            "Headline",
            "Link",
            "Summary"
          ]
        }
      },
      "summarizer": {
        "type": "csv_based",
        "function": "summarize_hk_news",
        "module": "summarizers.hk_news_summarizer",
        "inputs": {
          "data_source": {
            "type": "csv",
            "file": "hk_news.csv",
            "required": true
          },
          "section_title": {
            "default": "Hong Kong News",
            "customizable": true
          },
          "date_filter": {
            "default": "today",
            "options": [
              "today",
              "all"
            ]
          }
        },
        "output": {
          "format": "markdown",
          "section_title": "Hong Kong News"
        }
      },
      "customization": {
        "websites": {
          "can_customize": true,
          "method": "replace",
          "description": "Replace default websites with custom list"
        },
        "section_title": {
          "can_customize": true,
          "method": "replace",
          "description": "Custom section title in newsletter"
        }
      }
    },
    "tech_news": {
      "name": "Tech News",
      "description": "AI, robotics, and semiconductor news from TechCrunch, CNN Tech, CNBC Tech, 36Kr, Caixin Global, VKTR AI News, Electronics360 Supply Chain, Nikkei Asia Semiconductors (filtered for investment professionals)",
      "crawler": {
        "type": "generic_news",
        "config_key": "tech_news",
        "function": "crawl_tech_news",
        "module": "crawlers.generic_news_crawler",
        "inputs": {
          "websites": {
            "value": [
              "https://techcrunch.com/latest/",
              "https://edition.cnn.com/business/tech",
              "https://www.cnbc.com/technology/",
              "https://pitchhub.36kr.com/financing-flash",
              "https://www.caixinglobal.com/live/",
              "https://www.vktr.com/ai-news/",
              "https://electronics360.globalspec.com/supply-chain",
              "https://asia.nikkei.com/business/tech/semiconductors"
            ],
            "required": true,
            "customizable": true
          },
          "date_filter_mode": {
            "value": "today_or_yesterday",
            "default": "today_or_yesterday"
          },
          "special_handling": {
            "value": {
              "36kr.com": {
                "is_36kr": true
              }
            },
            "default": {}
          }
        },
        "output": {
          "type": "csv",
          "file": "tech_news.csv"
        }
      },
      "summarizer": {
        "type": "csv_based",
        "function": "summarize_tech_news",
        "module": "summarizers.tech_news_summarizer",
        "inputs": {
          "data_source": {
            "type": "csv",
            "file": "tech_news.csv"
          },
          "section_title": {
            "default": "AI / Robotics / Semiconductor News",
            "customizable": true
          }
        },
        "output": {
          "format": "markdown",
          "section_title": "AI / Robotics / Semiconductor News"
        }
      },
      "customization": {
        "websites": {
          "can_customize": true,
          "method": "replace"
        },
        "section_title": {
          "can_customize": true,
          "method": "replace"
        },
        "topics": {
          "can_customize": true,
          "method": "filter",
          "description": "Filter news by topics (e.g., AI, robotics)"
        }
      }
    },
    "financial_news": {
      "name": "Global Financial News",
      "description": "Financial news from CNBC World Markets, Futu News, AAStocks",
      "crawler": {
        "type": "generic_news",
        "config_key": "financial_news",
        "function": "crawl_global_financial_news",
        "module": "crawlers.generic_news_crawler",
        "inputs": {
          "websites": {
            "value": [
              "https://www.cnbc.com/world-markets/",
              "https://news.futunn.com/en/main",
              "http://www.aastocks.com/sc/mobile/news.aspx"
            ],
            "required": true,
            "customizable": true
          },
          "date_filter_mode": {
            "value": "today",
            "default": "today"
          },
          "special_handling": {
            "value": {
              "futunn.com": {
                "is_futu_news": true
              }
            }
          }
        },
        "output": {
          "type": "csv",
          "file": "financial_news.csv"
        }
      },
      "summarizer": {
        "type": "csv_based",
        "function": "summarize_global_financial_news",
        "module": "summarizers.global_financial_news_summarizer",
        "inputs": {
          "data_source": {
            "type": "csv",
            "file": "financial_news.csv"
          },
          "section_title": {
            "default": "Global Financial News",
            "customizable": true
          }
        },
        "output": {
          "format": "markdown",
          "section_title": "Global Financial News"
        }
      },
      "customization": {
        "websites": {
          "can_customize": true,
          "method": "replace"
        },
        "section_title": {
          "can_customize": true,
          "method": "replace"
        }
      }
    },
